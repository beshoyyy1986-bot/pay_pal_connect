# ===================== السيرفر =====================
PORT=8080

# لازم يكون الدومين الحقيقي (كولباك PayPal بيعتمد عليه)
BASE_URL=https://your-domain.com

# ===================== المتصفح (Playwright) =====================
# headless افتراضياً — خليها false بس للديباج
HEADLESS=true

# أقصى عدد جلسات متوازية (كل جلسة = متصفح كامل)
MAX_CONCURRENT_SESSIONS=2

# مهلات (ملي ثانية)
FB_NAV_TIMEOUT=45000
FB_SETTLE_MS=3500
FB_EVAL_TIMEOUT=60000
REQUEST_TIMEOUT_MS=180000

# عدد ملفات JS اللي تمسحها للبحث عن doc_id
FB_SCAN_FILES=90

# منطقة زمنية/وكيل مستخدم (اختياري)
# FB_TZ=Africa/Cairo
# FB_USER_AGENT=

# ===================== Meta Pay =====================
# اسم عملية بدء الربط (لو فيسبوك غيّرها)
PAYPAL_INIT_OP=useMetaPayWalletInitPayPalLinkingMutation

# doc_id احتياطي لو الاكتشاف التلقائي فشل
# PAYPAL_INIT_DOC_ID=

# profile_id الخاص بمحفظة Meta Pay
# PAYPAL_PROFILE_ID=

# قيمة __hs الاحتياطية
# FB_HS=20618.HYP:accounts_center_pkg.2.1..0

# ===================== الواجهة =====================
# VITE_API_URL=
