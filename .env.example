# ===== منفذ السيرفر =====
PORT=8080

# ===== رابط الدومين الخارجي (مهم جداً) =====
# لازم يكون الدومين الحقيقي اللي الأداة شغالة عليه، وإلا كولباك PayPal هيفشل.
# مثال: https://paypal-tool.up.railway.app
BASE_URL=https://your-domain.com

# ===== تجاوزات اختيارية (استخدمها فقط لو فيسبوك غيّر القيم) =====
# doc_id الخاص بـ useMetaPayWalletInitPayPalLinkingMutation
# لو سايبه فاضي، الأداة بتحاول تكتشفه تلقائياً من ملفات JS
# PAYPAL_INIT_DOC_ID=

# profile_id الخاص بمحفظة Meta Pay
# PAYPAL_PROFILE_ID=

# قيمة __hs الافتراضية
# FB_HS=20618.HYP:accounts_center_pkg.2.1..0

# ===== سلوك المتصفح =====
# خليها false لو عايز تشوف المتصفح (مفيد في الديباج)
HEADLESS=true

# ===== (اختياري) رابط الـ API لو الواجهة مستضافة لوحدها =====
# VITE_API_URL=
